<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#94005B" />
            <size android:width="320dp" android:height="180dp" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:width="320dp" android:height="180dp" android:gravity="center">
        <bitmap android:src="@drawable/mde_play_branding" android:gravity="fill" android:filter="true" />
    </item>
</layer-list>
